NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_URL=http://localhost:3000
# Configure all SMTP settings to enable business and customer email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Admin credentials: generate a PBKDF2 hash externally; never store a plaintext password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2$210000$RANDOM_SALT$DERIVED_HEX
AUTH_SECRET=replace_with_a_random_32_character_or_longer_secret
